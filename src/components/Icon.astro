---
import { iconPath } from '../lib/icons.mjs';
interface Props { name: string; class?: string; label?: string }
const { name, class: cls = 'ico', label } = Astro.props;
---
<svg class={cls} viewBox="0 0 256 256" fill="currentColor" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false"><path d={iconPath(name)} /></svg>

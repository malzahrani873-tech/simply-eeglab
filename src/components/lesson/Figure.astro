---
import { existsSync, readFileSync } from 'node:fs';
import { t } from '../../i18n';
import { langOf } from '../../lib/lang';
import { asset } from '../../lib/url';
import { datasetByCode } from '../../lib/site-data';
// source="ext" marks a figure taken from an openly licensed publication: credit, creditUrl, license and licenseUrl are then required.
interface Props { src: string; alt: string; caption?: string; source: string; bare?: boolean; credit?: string; creditUrl?: string; license?: string; licenseUrl?: string }
const { src, alt, caption, source, bare, credit: extCredit, creditUrl, license: extLicense, licenseUrl: extLicenseUrl } = Astro.props;
if (source === 'ext' && !(extCredit && creditUrl && extLicense && extLicenseUrl)) throw new Error(`Figure ${src}: source="ext" needs credit, creditUrl, license and licenseUrl`);
const lang = langOf(Astro.url);
// Bilingual drawings come as name.ar.svg / name.en.svg; otherwise the neutral file is used.
const stem = src.replace(/\.(svg|png|webp)$/, '');
const ext = src.match(/\.(\w+)$/)?.[1] ?? 'svg';
const candidates = [`${stem}.${lang}.${ext}`, src];
const file = candidates.find((c) => existsSync(`assets-src/lessons/${c}`));
if (!file) throw new Error(`Figure not found: assets-src/lessons/${src}`);
const head = readFileSync(`assets-src/lessons/${file}`, 'utf8').slice(0, 600);
const vb = head.match(/viewBox="[\d.\s-]*?([\d.]+)\s+([\d.]+)"/);
// Raster size from the file header (PNG IHDR, WebP VP8/VP8L/VP8X), so the reserved box has the right shape.
const rasterSize = (b: Buffer): [number, number] | null => {
  if (b.toString('ascii', 1, 4) === 'PNG') return [b.readUInt32BE(16), b.readUInt32BE(20)];
  if (b.toString('ascii', 0, 4) !== 'RIFF' || b.toString('ascii', 8, 12) !== 'WEBP') return null;
  const kind = b.toString('ascii', 12, 16);
  if (kind === 'VP8X') return [1 + b.readUIntLE(24, 3), 1 + b.readUIntLE(27, 3)];
  if (kind === 'VP8 ') return [b.readUInt16LE(26) & 0x3fff, b.readUInt16LE(28) & 0x3fff];
  if (kind === 'VP8L') { const v = b.readUInt32LE(21); return [1 + (v & 0x3fff), 1 + ((v >> 14) & 0x3fff)]; }
  return null;
};
const raster = ext === 'svg' ? null : rasterSize(readFileSync(`assets-src/lessons/${file}`).subarray(0, 32));
const width = raster?.[0] ?? Number(head.match(/\swidth="([\d.]+)"/)?.[1] ?? vb?.[1] ?? 720);
const height = raster?.[1] ?? Number(head.match(/\sheight="([\d.]+)"/)?.[1] ?? vb?.[2] ?? 400);
const ds = datasetByCode.get(source);
const credit = ds ? ds.credit[lang] : source === 'eeglab-ui' ? (lang === 'ar' ? 'لقطة من واجهة EEGLAB (SCCN)' : 'Screenshot of the EEGLAB interface (SCCN)') : '';
const shareAlike = ds?.shareAlike;
---
<figure class:list={['fig', { bare }]} data-license={shareAlike ? 'CC-BY-SA-4.0' : source === 'ext' ? extLicense : undefined}>
  <div class="fig-img"><img src={asset(`img/lessons/${file}`)} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></div>
  {(caption || credit || source === 'ext') && (
    <figcaption>
      {caption && <span set:html={caption} />}
      {credit && <span class="credit">{credit}{shareAlike && <> · <a href={ds.licenseUrl} rel="license">{lang === 'ar' ? 'رخصة الصورة' : 'Image licence'}: {ds.license}</a></>}</span>}
      {source === 'ext' && <span class="credit"><a href={creditUrl} rel="noopener" target="_blank" lang="en" dir="ltr">{extCredit}</a> · <a href={extLicenseUrl} rel="license noopener" target="_blank">{lang === 'ar' ? 'رخصة الصورة' : 'Image licence'}: <span lang="en" dir="ltr">{extLicense}</span></a></span>}
    </figcaption>
  )}
</figure>

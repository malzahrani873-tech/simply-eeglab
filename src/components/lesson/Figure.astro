---
import { existsSync, readFileSync } from 'node:fs';
import { t } from '../../i18n';
import { langOf } from '../../lib/lang';
import { asset } from '../../lib/url';
import { datasetByCode } from '../../lib/site-data';
// source="external": a figure taken from an openly licensed work; credit, creditUrl, license and licenseUrl are then required.
interface Props { src: string; alt: string; caption?: string; source: string; bare?: boolean; credit?: string; creditUrl?: string; license?: string; licenseUrl?: string }
const { src, alt, caption, source, bare, credit: extCredit, creditUrl, license: extLicense, licenseUrl: extLicenseUrl } = Astro.props;
const lang = langOf(Astro.url);
// Bilingual drawings come as name.ar.svg / name.en.svg; otherwise the neutral file is used.
const stem = src.replace(/\.(svg|png|webp)$/, '');
const ext = src.match(/\.(\w+)$/)?.[1] ?? 'svg';
const candidates = [`${stem}.${lang}.${ext}`, src];
const file = candidates.find((c) => existsSync(`assets-src/lessons/${c}`));
if (!file) throw new Error(`Figure not found: assets-src/lessons/${src}`);
const buf = readFileSync(`assets-src/lessons/${file}`);
const head = buf.toString('utf8', 0, 600);
const vb = head.match(/viewBox="[\d.\s-]*?([\d.]+)\s+([\d.]+)"/);
// Raster sizes come from the file header (PNG IHDR, WebP VP8/VP8L/VP8X), so the page reserves the right space.
const raster = (() => {
  if (buf.toString('ascii', 1, 4) === 'PNG') return [buf.readUInt32BE(16), buf.readUInt32BE(20)];
  if (buf.toString('ascii', 0, 4) !== 'RIFF' || buf.toString('ascii', 8, 12) !== 'WEBP') return null;
  const kind = buf.toString('ascii', 12, 16);
  if (kind === 'VP8 ') return [buf.readUInt16LE(26) & 0x3fff, buf.readUInt16LE(28) & 0x3fff];
  if (kind === 'VP8L') { const b = buf.readUInt32LE(21); return [(b & 0x3fff) + 1, ((b >> 14) & 0x3fff) + 1]; }
  if (kind === 'VP8X') return [buf.readUIntLE(24, 3) + 1, buf.readUIntLE(27, 3) + 1];
  return null;
})();
const width = raster?.[0] ?? Number(head.match(/\swidth="([\d.]+)"/)?.[1] ?? vb?.[1] ?? 720);
const height = raster?.[1] ?? Number(head.match(/\sheight="([\d.]+)"/)?.[1] ?? vb?.[2] ?? 400);
const ds = datasetByCode.get(source);
const credit = ds ? ds.credit[lang] : source === 'published' ? (pubCredit ?? '') : source === 'eeglab-ui' ? (lang === 'ar' ? 'لقطة من واجهة EEGLAB (SCCN)' : 'Screenshot of the EEGLAB interface (SCCN)') : '';
const shareAlike = ds?.shareAlike;
const external = source === 'external' && extCredit && creditUrl && extLicense && extLicenseUrl;
---
<figure class:list={['fig', { bare, 'fig-narrow': width < 600 }]} data-license={shareAlike ? 'CC-BY-SA-4.0' : external ? extLicense : undefined}>
  <div class="fig-img"><img src={asset(`img/lessons/${file}`)} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></div>
  {(caption || credit || external) && (
    <figcaption>
      {caption && <span set:html={caption} />}
      {external && <span class="credit"><a href={creditUrl} rel="noopener" target="_blank" lang="en" dir="ltr">{extCredit}</a> · <a href={extLicenseUrl} rel="license noopener" target="_blank">{lang === 'ar' ? 'رخصة الصورة' : 'Image licence'}: <span lang="en" dir="ltr">{extLicense}</span></a></span>}
      {credit && <span class="credit">{credit}{shareAlike && <> · <a href={ds.licenseUrl} rel="license">{lang === 'ar' ? 'رخصة الصورة' : 'Image licence'}: {ds.license}</a></>}</span>}
    </figcaption>
  )}
</figure>

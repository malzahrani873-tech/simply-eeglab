---
import { t } from '../../i18n';
import { langOf } from '../../lib/lang';
interface Props { pipeline?: string }
const { pipeline } = Astro.props;
const lang = langOf(Astro.url);
const S = {
  ar: {
    title: 'جرّب إعادة المرجع', ref: 'المرجع', orig: 'الأصلي (Cz)', mast: 'متوسط الماستويد (M1 و M2)', avg: 'المرجع المتوسط',
    bad: 'اجعل المرجع الأصلي سيئاً', newSig: 'إشارة جديدة',
    label: 'سبع قنوات لثلاث ثوانٍ بالمرجع المختار: {ref}.',
    note: 'تبسيط: أوزان المصادر يدوية لا نموذج رأس حقيقي، و7 أقطاب فقط. المرجع المتوسط في الواقع يحتاج تغطية جيدة للرأس بعدد كبير من القنوات.',
  },
  en: {
    title: 'Try re-referencing', ref: 'Reference', orig: 'Original (Cz)', mast: 'Linked mastoids (M1 & M2)', avg: 'Average reference',
    bad: 'Make the original reference noisy', newSig: 'New signal',
    label: 'Seven channels over three seconds with this reference: {ref}.',
    note: 'Simplified: hand-set source weights, not a real head model, and only 7 electrodes. A real average reference needs good coverage of the head with many channels.',
  },
}[lang];
---
<reref-demo class="fd" data-err={t(lang, 'interactive.error')} data-s={JSON.stringify(S)}>
  <p class="fd-static">{t(lang, 'interactive.noJs')}</p>
  {pipeline && <p class="demo-pipe" data-keep>{t(lang, 'demo.pipelineNote', { value: pipeline })}</p>}
</reref-demo>

<script>
  // Absolute potentials = sources x fixed weights; recorded channel = electrode - reference.
  // Re-referencing works on the recorded channels only, as EEGLAB does.
  const CH = ['Fp1', 'Fz', 'Cz', 'Pz', 'Oz', 'M1', 'M2'];
  const W = [ // alpha, theta, blink
    [0.2, 0.6, 1.0], [0.3, 0.9, 0.45], [0.5, 0.6, 0.2], [0.9, 0.3, 0.08], [1.0, 0.15, 0.04], [0.25, 0.1, 0.05], [0.25, 0.1, 0.05],
  ];
  const FS = 100, N = 300;
  class RerefDemoEl extends HTMLElement {
    s: any; ref = 'orig'; bad = false; abs: Float64Array[] = []; noise = new Float64Array(N); cv!: HTMLCanvasElement; dpr = 0; done = false;
    connectedCallback() {
      if (this.done) return; this.done = true;
      this.s = JSON.parse(this.dataset.s!);
      const S = this.s;
      const keep = this.querySelector('[data-keep]');
      this.innerHTML = `<div class="fdh"><b>${S.title}</b></div>
        <div class="ctl"><fieldset class="radio"><legend class="lab">${S.ref}</legend>
          ${['orig', 'mast', 'avg'].map((r) => `<label><input type="radio" name="rr-${Math.random().toString(36).slice(2, 6)}" value="${r}" ${r === 'orig' ? 'checked' : ''}>${S[r]}</label>`).join('')}</fieldset>
          <div class="crow"><label class="lab"><span class="sw"><input type="checkbox" role="switch" class="bad"><span></span></span>${S.bad}</label>
          <button type="button" class="btn small sec newSig">${S.newSig}</button></div></div>
        <div class="cv" dir="ltr"><canvas role="img"></canvas></div><p class="gt fd-note">${S.note}</p>`;
      if (keep) this.append(keep);
      this.cv = this.querySelector('canvas')!;
      this.addEventListener('change', (e) => {
        const tg = e.target as HTMLInputElement;
        if (tg.type === 'radio') this.ref = tg.value; else this.bad = tg.checked;
        this.draw();
      });
      this.querySelector('.newSig')!.addEventListener('click', () => { this.gen(); this.draw(); });
      new ResizeObserver(() => this.resize()).observe(this);
      new MutationObserver(() => this.draw()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      this.gen();
    }
    gen() {
      const r = Math.random, ph = [r() * 6, r() * 6], bl = [0.6 + r(), 1.9 + r() * 0.6];
      const src = [new Float64Array(N), new Float64Array(N), new Float64Array(N)];
      for (let i = 0; i < N; i++) {
        const t = i / FS;
        src[0][i] = 12 * Math.sin(2 * Math.PI * 10 * t + ph[0]);
        src[1][i] = 8 * Math.sin(2 * Math.PI * 5.5 * t + ph[1]);
        src[2][i] = bl.reduce((a, c) => a + 90 * Math.exp(-(((t - c) / 0.09) ** 2)), 0);
        this.noise[i] = 25 * Math.sin(2 * Math.PI * 23 * t) * Math.sin(2 * Math.PI * 0.7 * t) + 8 * (r() - 0.5);
      }
      this.abs = W.map((w) => Float64Array.from({ length: N }, (_, i) => w[0] * src[0][i] + w[1] * src[1][i] + w[2] * src[2][i] + (r() - 0.5) * 3));
    }
    channels() {
      const cz = 2;
      const absCz = Float64Array.from(this.abs[cz], (v, i) => v + (this.bad ? this.noise[i] : 0));
      const rec = this.abs.map((a, c) => (c === cz ? new Float64Array(N) : Float64Array.from(a, (v, i) => v - absCz[i])));
      if (this.ref === 'orig') return rec;
      const sub = (k: (i: number) => number) => rec.map((a) => Float64Array.from(a, (v, i) => v - k(i)));
      if (this.ref === 'mast') return sub((i) => (rec[5][i] + rec[6][i]) / 2);
      return sub((i) => rec.reduce((s, a) => s + a[i], 0) / rec.length);
    }
    resize() {
      const w = this.cv.clientWidth; if (!w) return;
      const dpr = Math.min(2, devicePixelRatio || 1); this.cv.style.height = '280px'; this.cv.width = w * dpr; this.cv.height = 280 * dpr; this.dpr = dpr; this.draw();
    }
    draw() {
      if (!this.dpr || !this.abs.length) return;
      const cs = getComputedStyle(this), col = (n: string) => cs.getPropertyValue(n).trim();
      const C = this.cv.getContext('2d')!, Wd = this.cv.clientWidth, H = 280, padL = 44, rowH = (H - 16) / CH.length;
      C.setTransform(this.dpr, 0, 0, this.dpr, 0, 0); C.clearRect(0, 0, Wd, H);
      C.font = '12px "JetBrains Mono", monospace'; C.textBaseline = 'middle'; C.textAlign = 'right';
      const data = this.channels();
      data.forEach((a, c) => {
        const y0 = 8 + rowH * (c + 0.5);
        C.fillStyle = col('--muted'); C.fillText(CH[c], padL - 8, y0);
        C.strokeStyle = col('--sep'); C.lineWidth = 1; C.beginPath(); C.moveTo(padL, y0); C.lineTo(Wd - 6, y0); C.stroke();
        C.strokeStyle = this.ref === 'orig' && c === 2 ? col('--bs') : col('--primary'); C.lineWidth = 1.3; C.beginPath();
        for (let i = 0; i < N; i++) { const X = padL + (i / (N - 1)) * (Wd - padL - 6), Y = y0 - a[i] * (rowH / 140); i ? C.lineTo(X, Y) : C.moveTo(X, Y); }
        C.stroke();
      });
      this.cv.setAttribute('aria-label', this.s.label.replace('{ref}', this.s[this.ref]));
    }
  }
  customElements.define('reref-demo', RerefDemoEl);
</script>

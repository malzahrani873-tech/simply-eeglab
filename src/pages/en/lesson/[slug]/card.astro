---
import CardPage from '../../../../components/CardPage.astro';
import { lessons, slugOf } from '../../../../lib/site-data';
export async function getStaticPaths() {
  return [...(await lessons()).values()].filter((l) => l.id.startsWith('en/')).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CardPage lang="en" entry={entry} slug={Astro.params.slug} />

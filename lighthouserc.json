{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/station/03/index.html",
        "http://localhost/en/station/03/index.html",
        "http://localhost/lesson/filtering/index.html",
        "http://localhost/en/lesson/filtering/index.html",
        "http://localhost/lesson/epoch-rejection/index.html",
        "http://localhost/lesson/filtering/card/index.html",
        "http://localhost/ica-game/index.html",
        "http://localhost/en/ica-game/index.html",
        "http://localhost/search/index.html",
        "http://localhost/en/search/index.html",
        "http://localhost/progress/index.html",
        "http://localhost/about/index.html",
        "http://localhost/references/index.html",
        "http://localhost/plugins/index.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
